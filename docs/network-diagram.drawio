        <mxCell id="host" value="&lt;b&gt;Host&lt;/b&gt;&lt;br&gt;Linux Mint + VMware&lt;br&gt;10.10.10.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
