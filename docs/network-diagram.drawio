        <mxCell id="wazuh" value="&lt;b&gt;WAZUH&lt;/b&gt;&lt;br&gt;SIEM&lt;br&gt;10.10.10.40" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
