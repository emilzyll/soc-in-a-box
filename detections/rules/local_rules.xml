<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<group name="local,audit,">
  <rule id="100100" level="8">
    <if_group>audit</if_group>
    <field name="audit.key">passwd_changes</field>
    <description>Auditd: /etc/passwd modified</description>
  </rule>

  <rule id="100101" level="8">
    <if_group>audit</if_group>
    <field name="audit.key">shadow_changes</field>
    <description>Auditd: /etc/shadow modified</description>
  </rule>

  <rule id="100102" level="10">
    <if_group>audit</if_group>
    <field name="audit.key">sudoers_changes</field>
    <description>Auditd: sudoers modified</description>
  </rule>
</group>
